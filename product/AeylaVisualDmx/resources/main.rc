// AEYLA Visual DMX Windows standalone resources.
// The iPlug2 APP host calls CreateDialog(IDD_DIALOG_MAIN). Without this file the
// process enters its message loop but never creates a native window.

#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
// Standalone host dialogs

IDD_DIALOG_PREF DIALOGEX 0, 0, 223, 309
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "AEYLA Preferences"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,110,285,50,14
    PUSHBUTTON      "Apply",IDAPPLY,54,285,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,166,285,50,14
    COMBOBOX        IDC_COMBO_AUDIO_DRIVER,20,35,100,100,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Driver Type",IDC_STATIC,22,25,50,8
    COMBOBOX        IDC_COMBO_AUDIO_IN_DEV,20,65,100,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Input Device",IDC_STATIC,20,55,50,8
    COMBOBOX        IDC_COMBO_AUDIO_OUT_DEV,20,95,100,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Output Device",IDC_STATIC,20,85,55,8
    COMBOBOX        IDC_COMBO_AUDIO_BUF_SIZE,135,35,65,100,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Buffer Size",IDC_STATIC,137,25,50,8
    COMBOBOX        IDC_COMBO_AUDIO_SR,135,95,65,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Sampling Rate",IDC_STATIC,135,85,55,8
    GROUPBOX        "Audio Device Settings",IDC_STATIC,5,10,210,170
    PUSHBUTTON      "Config...",IDC_BUTTON_OS_DEV_SETTINGS,135,155,65,14
    COMBOBOX        IDC_COMBO_AUDIO_IN_L,20,125,40,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Input 1 (L)",IDC_STATIC,20,115,40,8
    COMBOBOX        IDC_COMBO_AUDIO_IN_R,65,126,40,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Input 2 (R)",IDC_STATIC,65,115,40,8
    COMBOBOX        IDC_COMBO_AUDIO_OUT_L,20,155,40,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Output 1 (L)",IDC_STATIC,20,145,45,8
    COMBOBOX        IDC_COMBO_AUDIO_OUT_R,65,155,40,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Output 2 (R)",IDC_STATIC,65,145,45,8
    GROUPBOX        "MIDI Device Settings",IDC_STATIC,5,190,210,85
    COMBOBOX        IDC_COMBO_MIDI_OUT_DEV,15,250,100,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Output Device",IDC_STATIC,15,240,55,8
    COMBOBOX        IDC_COMBO_MIDI_IN_DEV,15,220,100,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Input Device",IDC_STATIC,15,210,50,8
    LTEXT           "Input Channel",IDC_STATIC,125,210,50,8
    COMBOBOX        IDC_COMBO_MIDI_IN_CHAN,125,220,50,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
    LTEXT           "Output Channel",IDC_STATIC,125,240,55,8
    COMBOBOX        IDC_COMBO_MIDI_OUT_CHAN,125,250,50,200,CBS_DROPDOWNLIST | CBS_HASSTRINGS
END

IDD_DIALOG_MAIN DIALOGEX 0, 0, 640, 400
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "AEYLA Visual DMX"
MENU IDR_MENU1
FONT 9, "Segoe UI"
BEGIN
END

/////////////////////////////////////////////////////////////////////////////
// Menu and shortcuts

IDR_MENU1 MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Preferences...\tCtrl+,", ID_PREFERENCES
        MENUITEM SEPARATOR
        MENUITEM "E&xit", ID_QUIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Show Control &Bounds\tCtrl+B", ID_SHOW_BOUNDS
        MENUITEM "Show &Drawn Area\tCtrl+D", ID_SHOW_DRAWN
        MENUITEM "Show &FPS\tCtrl+F", ID_SHOW_FPS
        MENUITEM "Live &Edit Mode\tCtrl+E", ID_LIVE_EDIT
        MENUITEM SEPARATOR
        MENUITEM "Save Screenshot\tCtrl+Shift+S", ID_SCREENSHOT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About AEYLA Visual DMX", ID_ABOUT
        MENUITEM "&Documentation", ID_HELP
    END
END

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    VK_OEM_COMMA, ID_PREFERENCES, VIRTKEY, CONTROL, NOINVERT
    "B", ID_SHOW_BOUNDS, VIRTKEY, CONTROL, NOINVERT
    "D", ID_SHOW_DRAWN, VIRTKEY, CONTROL, NOINVERT
    "F", ID_SHOW_FPS, VIRTKEY, CONTROL, NOINVERT
    "E", ID_LIVE_EDIT, VIRTKEY, CONTROL, NOINVERT
    "S", ID_SCREENSHOT, VIRTKEY, CONTROL, SHIFT, NOINVERT
END

/////////////////////////////////////////////////////////////////////////////
// Version metadata

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,1,2
 PRODUCTVERSION 0,2,1,2
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "RGB Estudios"
            VALUE "FileDescription", "AEYLA Visual DMX Standalone"
            VALUE "FileVersion", "0.2.1-alpha.3"
            VALUE "InternalName", "AeylaVisualDmx"
            VALUE "LegalCopyright", "Copyright 2026 RGB Estudios"
            VALUE "OriginalFilename", "AeylaVisualDmx.exe"
            VALUE "ProductName", "AEYLA Visual DMX"
            VALUE "ProductVersion", "0.2.1-alpha.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
